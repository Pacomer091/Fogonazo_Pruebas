# Fogonazo OS - Variables de Entorno Supabase
# Puedes proporcionar o bien la DATABASE_URL (recomendado) o la SUPABASE_URL + SUPABASE_KEY:

# 1. Conexión directa PostgreSQL (Recomendado)
# Se obtiene en: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres:[TU_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# 2. O bien las credenciales de la API de Supabase:
# Se obtienen en: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_KEY=eyJhbGciOi...
